---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/content/PageHeader.astro';
import InquiryPanel from '../components/forms/InquiryPanel.astro';
import Icon from '../components/ui/Icon.astro';
---

<SiteLayout
  title="Get Involved"
  description="Explore how students, researchers, educators and civic builders could contribute to CLTS’s emerging work."
>
  <PageHeader
    eyebrow="Get involved"
    title="Your perspective belongs in the conversation."
    description="For curious students, researchers, educators, technologists and people who care about the digital future."
  />
  <section class="section">
    <div class="container">
      <div class="involvement-row">
        <span>01</span>
        <h2>Learn & participate</h2>
        <div>
          <p>
            Future dialogues and practical learning opportunities will be
            published on our Events page. No open registrations are available
            yet.
          </p>
          <a class="text-link" href="/events">
            View Events
            <Icon size={18} />
          </a>
        </div>
      </div>
      <div class="involvement-row">
        <span>02</span>
        <h2>Contribute a question or expertise</h2>
        <div>
          <p>
            Explore our focus areas and consider where your research, teaching
            or technical experience could support a useful collaboration.
          </p>
          <a class="text-link" href="/our-work">
            Explore Our Work
            <Icon size={18} />
          </a>
        </div>
      </div>
      <div class="involvement-row">
        <span>03</span>
        <h2>Shape something together</h2>
        <div>
          <p>
            Research institutions, educators and civic builders can explore
            potential dialogues, learning programmes and public-interest
            challenges with CLTS.
          </p>
          <a class="text-link" href="/partnerships">
            Explore Partnerships
            <Icon size={18} />
          </a>
        </div>
      </div>
      <p class="notice" style="margin-top:32px">
        There are no advertised vacancies, fellowships or volunteer placements
        at present. Any future opportunities will have clear expectations and
        application details.
      </p>
    </div>
  </section>
  <section class="section" style="padding-top:0">
    <div class="container">
      <InquiryPanel />
    </div>
  </section>
</SiteLayout>
