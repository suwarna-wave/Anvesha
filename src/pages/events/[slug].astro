---
import { sitePath } from '../../lib/urls';
import { render } from 'astro:content';
import { pillars } from '../../content/pillars';
import type { CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeader from '../../components/content/PageHeader.astro';
import Button from '../../components/ui/Button.astro';
import { publicEvents, formatDate, formatEventTime } from '../../lib/content';
import { eventRegistrationAvailable } from '../../lib/content-policy';
export async function getStaticPaths() {
  return (await publicEvents()).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}
interface Props {
  entry: CollectionEntry<'events'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const registrationOpen = eventRegistrationAvailable(entry.data);
const data = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: entry.data.title,
  description: entry.data.summary,
  startDate: entry.data.startsAt!.toISOString(),
  ...(entry.data.endsAt && { endDate: entry.data.endsAt.toISOString() }),
  eventStatus:
    entry.data.state === 'cancelled'
      ? 'https://schema.org/EventCancelled'
      : 'https://schema.org/EventScheduled',
  location:
    entry.data.format === 'Online'
      ? { '@type': 'VirtualLocation', name: entry.data.location }
      : { '@type': 'Place', name: entry.data.location },
};
---

<SiteLayout
  title={entry.data.title}
  description={entry.data.summary}
  structuredData={data}
>
  <PageHeader
    eyebrow={`${entry.data.type} · ${entry.data.state}`}
    title={entry.data.title}
    description={entry.data.summary}
  >
    <div class="detail-meta">
      <time datetime={entry.data.startsAt!.toISOString()}>
        {formatDate(entry.data.startsAt!)} ·{' '}
        {formatEventTime(entry.data.startsAt!)} NPT (Asia/Kathmandu)
      </time>
      <span>
        {entry.data.format} · {entry.data.location}
      </span>
    </div>
  </PageHeader>
  <div class="container detail-topics">
    {entry.data.pillars.map((id) => (
      <a href={sitePath(`/our-work#${id}`)}>
        {pillars.find((pillar) => pillar.id === id)?.title}
      </a>
    ))}
  </div>
  <div class="reading-layout">
    <div class="container">
      <article class="prose">
        {entry.data.state === 'cancelled' && (
          <p class="notice">
            This event has been cancelled. Registration is unavailable.
          </p>
        )}
        {entry.data.state === 'full' && (
          <p class="notice">This event is full. Registration is closed.</p>
        )}
        {(entry.data.state === 'completed' ||
          entry.data.startsAt! < new Date()) && (
          <p class="notice">
            This is an archived event. Registration is closed.
          </p>
        )}
        <Content />
        {entry.data.accessNotes && (
          <>
            <h2>Accessibility</h2>
            <p>{entry.data.accessNotes}</p>
          </>
        )}
        {entry.data.speakers.length > 0 && (
          <>
            <h2>Confirmed speakers</h2>
            <ul>
              {entry.data.speakers.map((speaker) => (
                <li>{speaker}</li>
              ))}
            </ul>
          </>
        )}
        {entry.data.deadline && (
          <p>
            Registration deadline: {formatDate(entry.data.deadline)} at{' '}
            {formatEventTime(entry.data.deadline)} NPT.
          </p>
        )}
      </article>
      <div class="detail-actions">
        {registrationOpen && (
          <Button href={entry.data.registrationUrl!}>
            Register on External Site
          </Button>
        )}
        {!registrationOpen && entry.data.state === 'open' && (
          <p class="small">Registration is currently unavailable.</p>
        )}
        <a class="text-link" href={sitePath('/events')}>
          ← Back to Events
        </a>
      </div>
    </div>
  </div>
</SiteLayout>
