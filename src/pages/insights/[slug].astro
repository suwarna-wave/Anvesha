---
import { render } from 'astro:content';
import { pillars } from '../../content/pillars';
import type { CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeader from '../../components/content/PageHeader.astro';
import Button from '../../components/ui/Button.astro';
import ShareLink from '../../components/content/ShareLink.astro';
import { publicInsights, formatDate } from '../../lib/content';
export async function getStaticPaths() {
  return (await publicInsights()).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}
interface Props {
  entry: CollectionEntry<'insights'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const data = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.summary,
  author: entry.data.authors.map((name) => ({ '@type': 'Person', name })),
  datePublished: entry.data.publishedAt!.toISOString(),
  ...(entry.data.updatedAt && {
    dateModified: entry.data.updatedAt.toISOString(),
  }),
};
---

<SiteLayout
  title={entry.data.title}
  description={entry.data.summary}
  structuredData={data}
>
  <PageHeader
    eyebrow={entry.data.type}
    title={entry.data.title}
    description={entry.data.summary}
  >
    <div class="detail-meta">
      <span>By {entry.data.authors.join(', ')}</span>
      <time datetime={entry.data.publishedAt!.toISOString()}>
        {formatDate(entry.data.publishedAt!)}
      </time>
      {entry.data.updatedAt && (
        <span>Updated {formatDate(entry.data.updatedAt)}</span>
      )}
    </div>
  </PageHeader>
  <div class="container detail-topics">
    {entry.data.pillars.map((id) => (
      <a href={`/our-work#${id}`}>
        {pillars.find((pillar) => pillar.id === id)?.title}
      </a>
    ))}
  </div>
  <div class="reading-layout">
    <div class="container">
      <article class="prose">
        <Content />
        {entry.data.sources.length > 0 && (
          <>
            <h2>Sources</h2>
            <ol>
              {entry.data.sources.map((source) => (
                <li>
                  <a href={source.url}>{source.title}</a>
                </li>
              ))}
            </ol>
          </>
        )}
      </article>
      <div class="detail-actions">
        {entry.data.report && (
          <Button href={entry.data.report}>Download Report (PDF)</Button>
        )}
        <ShareLink />
        <a class="text-link" href="/insights">
          ← Back to Insights
        </a>
      </div>
    </div>
  </div>
</SiteLayout>
