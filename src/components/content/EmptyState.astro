---
import Icon from '../ui/Icon.astro';
interface Props {
  title: string;
  description: string;
  icon?: string;
}
const { title, description, icon = 'policy' } = Astro.props;
---

<div class="empty-state">
  <span class="empty-icon">
    <Icon name={icon} size={28} />
  </span>
  <div>
    <h2>{title}</h2>
    <p>{description}</p>
    <slot />
  </div>
</div>
