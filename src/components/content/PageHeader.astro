---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<section class="page-header">
  <div class="container">
    <p class="eyebrow">
      <span class="tiny-rule"></span>
      {eyebrow}
    </p>
    <h1>{title}</h1>
    {description && <p class="page-deck">{description}</p>}
    <slot />
  </div>
</section>
