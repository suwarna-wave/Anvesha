---
import pyramid from '../../assets/commons-pyramid.svg?raw';
interface Props {
  small?: boolean;
}
const { small = false } = Astro.props;
---

<div class:list={['commons-visual', { 'commons-visual--small': small }]}>
  <Fragment set:html={pyramid} />
  {!small && (
    <div class="visual-caption">
      <span>THE DIGITAL COMMONS</span>
      <span>Different perspectives. Shared foundations.</span>
    </div>
  )}
</div>
