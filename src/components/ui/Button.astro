---
import { sitePath } from '../../lib/urls';
import Icon from './Icon.astro';
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'light' | 'text';
  class?: string;
}
const { href, variant = 'primary', class: className } = Astro.props;
---

<a
  href={sitePath(href)}
  class:list={['button', `button--${variant}`, className]}
>
  <slot />
  <Icon name="arrow" size={18} />
</a>
