{
  "name": "anvesha-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx tests/content.test.ts",
    "test:site": "node scripts/check-site.mjs",
    "test:browser": "playwright test",
    "assets:og": "node scripts/generate-og.mjs",
    "test:integration": "node scripts/test-integration.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@tailwindcss/vite": "4.3.4",
    "astro": "7.4.5",
    "tailwindcss": "4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "lighthouse": "13.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "sharp": "0.35.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "minimatch": "11.0.4",
    "glob": "14.0.3"
  }
}
